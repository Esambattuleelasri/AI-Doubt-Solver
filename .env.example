# ─────────────────────────────────────────────
#  AI Doubt Solver Pro — Environment Variables
#  Copy this file to .env and fill in your values
# ─────────────────────────────────────────────

# ── LLM Provider ──────────────────────────────
# Options: "openai" | "ollama"
LLM_PROVIDER=openai

# OpenAI (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o

# Ollama (required if LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Gemini (required if LLM_PROVIDER=gemini)
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-1.5-flash

# ── Database ───────────────────────────────────
# SQLite (default, no setup needed)
DATABASE_URL=sqlite:///./ai_doubt_solver.db

# PostgreSQL (uncomment to use)
# DATABASE_URL=postgresql://user:password@localhost:5432/ai_doubt_solver

# ── Auth ───────────────────────────────────────
JWT_SECRET_KEY=change-me-to-a-random-secret-key-32chars
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── Google OAuth (optional) ───────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── App Settings ──────────────────────────────
APP_NAME=AI Doubt Solver Pro
APP_ENV=development
DEBUG=true

# ── Upload Settings ────────────────────────────
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20

# ── Embedding Model ────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Default Language ───────────────────────────
DEFAULT_LANGUAGE=en
